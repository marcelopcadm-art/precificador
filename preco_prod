<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Precificador Pro</title>

<!-- 📊 LIB EXCEL -->
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<style>
* {
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', sans-serif;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: #fff;
  margin: 0;
  min-height: 100vh;

  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 40px 20px;
}

.container {
  width: 100%;
  max-width: 2000px;
}

h1 {
  text-align: center;
  color: #38bdf8;
  margin-bottom: 20px;
}

.box {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
  padding: 20px;
  border-radius: 15px;
  margin-bottom: 20px;
  box-shadow: 0 0 20px rgba(56,189,248,0.2);
  width: 100%;
}

input, button {
  padding: 10px;
  margin: 5px;
  border-radius: 8px;
  border: none;
}

input {
  background: #0f172a;
  color: #fff;
  border: 1px solid #38bdf8;
}

button {
  background: #38bdf8;
  color: #000;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  background: #0ea5e9;
}

.table-container {
  width: 100%;
  overflow-x: auto;
}

table {
  width: 100%;
  min-width: 1000px;
  border-collapse: collapse;
}

th, td {
  padding: 10px;
  border-bottom: 1px solid #334155;
  text-align: center;
  white-space: nowrap;
}

th {
  color: #38bdf8;
}

.delete-btn {
  background: #ef4444;
  color: white;
}

.delete-btn:hover {
  background: #dc2626;
}

#resultado {
  margin-top: 10px;
  font-size: 18px;
  color: #22c55e;
}
</style>
</head>

<body>

<div class="container">

<h1>🚀 Precificador Inteligente</h1>

<div class="box">
  <h3>Adicionar Produto</h3>

  <input type="text" id="nome" placeholder="Nome do produto">
  <input type="text" id="categoria" placeholder="Categoria">

  <input type="number" id="custoUnit" placeholder="Custo unitário (R$)" oninput="calcularTotal()">
  <input type="number" id="quantidade" placeholder="Quantidade" oninput="calcularTotal()">
  <input type="number" id="frete" placeholder="Frete total (R$)" oninput="calcularTotal()">
  <input type="number" id="custoTotal" placeholder="Custo total (R$)" readonly>

  <br>

  <!-- ✔ SHOPEE CHECKBOX -->
  <label style="margin-left:5px;">
    <input type="checkbox" id="shopee">
    Já cadastrado na Shopee
  </label>

  <br><br>

  <button onclick="salvar()">Calcular e Salvar</button>
  <button onclick="gerarRelatorio()">📄 Baixar Excel</button>

  <div id="resultado"></div>
</div>

<div class="box">
  <h3>📊 Histórico</h3>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th>Produto</th>
          <th>Categoria</th>
          <th>Custo Unit.</th>
          <th>Qtd</th>
          <th>Frete</th>
          <th>Preço Venda</th>
          <th>Lucro</th>
          <th>Data</th>
          <th>Shopee</th>
          <th>Ação</th>
        </tr>
      </thead>
      <tbody id="tabela"></tbody>
    </table>
  </div>

</div>

</div>

<script>
function calcularTotal() {
  let unit = parseFloat(document.getElementById("custoUnit").value) || 0;
  let qtd = parseInt(document.getElementById("quantidade").value) || 0;
  let frete = parseFloat(document.getElementById("frete").value) || 0;

  let total = (unit * qtd) + frete;
  document.getElementById("custoTotal").value = total.toFixed(2);
}

function salvar() {
  let nome = document.getElementById("nome").value;
  let categoria = document.getElementById("categoria").value;
  let unit = parseFloat(document.getElementById("custoUnit").value);
  let qtd = parseInt(document.getElementById("quantidade").value);
  let frete = parseFloat(document.getElementById("frete").value) || 0;
  let shopee = document.getElementById("shopee").checked;

  if (!nome || !categoria || !unit || !qtd) {
    alert("Preencha todos os campos!");
    return;
  }

  let custoTotal = (unit * qtd) + frete;
  let custoFinalUnit = custoTotal / qtd;

  let precoVenda = custoFinalUnit / (1 - 0.15);
  let lucro = precoVenda - custoFinalUnit;

  let data = new Date().toLocaleString();

  let produto = {
    nome,
    categoria,
    unit: custoFinalUnit.toFixed(2),
    qtd,
    frete: frete.toFixed(2),
    preco: precoVenda.toFixed(2),
    lucro: lucro.toFixed(2),
    data,
    shopee
  };

  let lista = JSON.parse(localStorage.getItem("produtos")) || [];
  lista.push(produto);
  localStorage.setItem("produtos", JSON.stringify(lista));

  document.getElementById("resultado").innerHTML =
    `Preço ideal: R$ ${precoVenda.toFixed(2)} | Lucro unitário: R$ ${lucro.toFixed(2)}`;

  carregar();
}

function carregar() {
  let tabela = document.getElementById("tabela");
  tabela.innerHTML = "";

  let lista = JSON.parse(localStorage.getItem("produtos")) || [];

  lista.forEach((p, index) => {
    tabela.innerHTML += `
      <tr>
        <td>${p.nome}</td>
        <td>${p.categoria}</td>
        <td>R$ ${p.unit}</td>
        <td>${p.qtd}</td>
        <td>R$ ${p.frete}</td>
        <td>R$ ${p.preco}</td>
        <td>R$ ${p.lucro}</td>
        <td>${p.data}</td>
        <td><input type="checkbox" disabled ${p.shopee ? "checked" : ""}></td>
        <td><button class="delete-btn" onclick="excluir(${index})">Excluir</button></td>
      </tr>
    `;
  });
}

function excluir(index) {
  let lista = JSON.parse(localStorage.getItem("produtos")) || [];
  lista.splice(index, 1);
  localStorage.setItem("produtos", JSON.stringify(lista));
  carregar();
}

function gerarRelatorio() {
  let lista = JSON.parse(localStorage.getItem("produtos")) || [];

  if (lista.length === 0) {
    alert("Nenhum produto cadastrado!");
    return;
  }

  let dados = lista.map(p => ({
    Produto: p.nome,
    Categoria: p.categoria,
    Quantidade: p.qtd,
    "Custo Unitário": p.unit,
    Frete: p.frete,
    "Preço Venda": p.preco,
    Lucro: p.lucro,
    Data: p.data,
    Shopee: p.shopee ? "Sim" : "Não"
  }));

  let ws = XLSX.utils.json_to_sheet(dados);
  let wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, "Produtos");

  XLSX.writeFile(wb, "relatorio_produtos.xlsx");
}

carregar();
</script>

</body>
</html>
